# Copy this file to .env and adjust if needed.
# All values below are fictitious and safe for local development.

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---
POSTGRES_USER=noar
POSTGRES_PASSWORD=noar_dev_password
POSTGRES_DB=noar
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://noar:noar_dev_password@db:5432/noar

# --- API ---
API_SECRET_KEY=change-me-dev-only-not-a-real-secret
API_PORT=8000

# --- Email (Mailpit, fake SMTP server for local dev) ---
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noar@localhost
# Real SMTP is optional and only used when SMTP_HOST/PORT point to a real server.

# --- Telegram (optional; real bot only needed outside tests) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- Webhook demo receiver ---
WEBHOOK_RECEIVER_URL=http://webhook-receiver:8080

# --- Demo target (fake monitored site) ---
DEMO_TARGET_URL=http://demo-target:80

# --- Worker scheduler (ADR 0003) ---
SCHEDULER_BATCH_SIZE=20
SCHEDULER_LEASE_SECONDS=60
SCHEDULER_POLL_INTERVAL_SECONDS=5.0
SCHEDULER_JITTER_FRACTION=0.1
SCHEDULER_CHECK_CONCURRENCY=10
# Off by default (see ADR 0005); only the worker service in docker-compose.yml
# turns this on, since it is the one that needs to reach demo-target.
SSRF_ALLOW_PRIVATE_NETWORKS=false

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
